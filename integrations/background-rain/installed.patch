+param([switch]$NewLink)
+$ErrorActionPreference='Stop'
+$root=(Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..')).Path
+$mutex=[Threading.Mutex]::new($false,'Local\STANK_TANK_BUFF_TRIAL')
+$locked=$false
+$statusPath=Join-Path $root 'private\buff-trial-status.json'
+try{
+ $locked=$mutex.WaitOne(0)
+ if(-not $locked){throw 'A Buff link is already being prepared.'}
+ $cfg=Get-Content -LiteralPath (Join-Path $root 'private\producer.local.json') -Raw|ConvertFrom-Json
+ $local='http://127.0.0.1:'+$cfg.panelPort
+ $localHeaders=@{Authorization='Bearer '+$cfg.panelToken;Origin=$local}
+ $state=$null
+ try{$state=Invoke-RestMethod ($local+'/api/status') -Headers $localHeaders -TimeoutSec 3}catch{}
+ if($state -and $state.busy){throw 'Finish the exchange before preparing a Buff link.'}
+ $exe=Join-Path $root 'tools\cloudflared.exe'
+ if(-not (Test-Path -LiteralPath $exe)){throw 'The installed Cloudflare trial helper is missing.'}
+ @{state='preparing'}|ConvertTo-Json|Set-Content -LiteralPath $statusPath -Encoding utf8
+ if($NewLink){& (Join-Path $root 'scripts\Stop-Buff-Trial.ps1')|Out-Null}
+ $recordPath=Join-Path $root 'private\buff-tunnel-process.json'
+ $log=Join-Path $root 'private\buff-tunnel.stderr.log'
+ $owned=$null
+ if(Test-Path -LiteralPath $recordPath){
+  $record=Get-Content -LiteralPath $recordPath -Raw|ConvertFrom-Json
+  $candidate=Get-Process -Id $record.pid -ErrorAction SilentlyContinue
+  if($candidate -and $candidate.Path -eq $exe -and $candidate.StartTime.ToUniversalTime().Ticks -eq ([datetime]$record.created_at).ToUniversalTime().Ticks){$owned=$candidate}
+ }
+ if(-not $owned){
+  $owned=Start-Process -FilePath $exe -ArgumentList @('tunnel','--no-autoupdate','--url',$local) -WindowStyle Hidden -PassThru -RedirectStandardError $log -RedirectStandardOutput (Join-Path $root 'private\buff-tunnel.stdout.log')
+  [pscustomobject]@{pid=$owned.Id;created_at=$owned.StartTime.ToUniversalTime().ToString('o')}|ConvertTo-Json|Set-Content -LiteralPath $recordPath -Encoding utf8
+ }
+ $deadline=(Get-Date).AddSeconds(40);$origin=$null
+ do{
+  if($owned.HasExited){throw 'The HTTPS helper stopped. Check private\buff-tunnel.stderr.log.'}
+  if(Test-Path -LiteralPath $log){
+   $contents=Get-Content -LiteralPath $log -Raw
+   if($contents){$match=[regex]::Match($contents,'https://[a-z0-9-]+\.trycloudflare\.com');if($match.Success){$origin=$match.Value;break}}
+  }
+  Start-Sleep -Milliseconds 250
+ }while((Get-Date) -lt $deadline)
+ if(-not $origin){throw 'Cloudflare did not return a trial address.'}
+ if(-not $state){
+  $mode=if($cfg.outputOwner -eq 'obs'){'obs'}else{'browser'}
+  & (Join-Path $root 'scripts\Launch-STANK-TANK.ps1') -Mode $mode -NoViews|Out-Null
+ }
+ # Update the running host; models, output mode and voices stay warm.
+ $null=Invoke-RestMethod ($local+'/api/buff-origin') -Method Post -Headers $localHeaders -ContentType 'application/json' -Body (@{origin=$origin}|ConvertTo-Json) -TimeoutSec 10
+ $headers=@{Authorization='Bearer '+$cfg.panelToken;Origin=$origin}
+ $verified=$null;$deadline=(Get-Date).AddSeconds(60)
+ do{
+  try{$verified=Invoke-RestMethod ($origin+'/api/status') -Headers $headers -TimeoutSec 8;if($verified.kind -eq 'REMOTE_TESTING'){break}}catch{}
+  Start-Sleep -Milliseconds 800
+ }while((Get-Date) -lt $deadline)
+ if(-not $verified -or $verified.kind -ne 'REMOTE_TESTING'){throw 'The public HTTPS control check did not pass; no launcher was issued.'}
+ $folder=Join-Path $root 'For Buff'
+ New-Item -ItemType Directory -Path $folder -Force|Out-Null
+ $viewer=(Get-Content -LiteralPath (Join-Path $cfg.scratch 'obs-viewer-key.local.json') -Raw|ConvertFrom-Json).key
+ ('[InternetShortcut]'+[Environment]::NewLine+'URL='+$origin+'/#key='+$cfg.panelToken+[Environment]::NewLine)|Set-Content -LiteralPath (Join-Path $folder 'Buff Controls.url') -Encoding utf8
+ ('[InternetShortcut]'+[Environment]::NewLine+'URL='+$origin+'/live#key='+$viewer+[Environment]::NewLine)|Set-Content -LiteralPath (Join-Path $folder 'Live Show Viewer.url') -Encoding utf8
+ ($origin+'/stage#key='+$viewer)|Set-Content -LiteralPath (Join-Path $folder 'OBS Browser Source.txt') -Encoding utf8
+ Copy-Item -LiteralPath (Join-Path $root 'docs\BUFF_TRIAL_QUICK_START.txt') -Destination (Join-Path $folder 'READ ME FIRST.txt')
+ @{state='ready';origin=$origin;checked_at=[datetime]::UtcNow.ToString('o')}|ConvertTo-Json|Set-Content -LiteralPath $statusPath -Encoding utf8
+ Write-Output 'Buff HTTPS controls verified. The current private launchers are in For Buff.'
+}catch{
+ if($locked){@{state='error'}|ConvertTo-Json|Set-Content -LiteralPath $statusPath -Encoding utf8}
+ $_.Exception.Message|Set-Content -LiteralPath (Join-Path $root 'private\buff-trial-error.txt') -Encoding utf8
+ throw
+}finally{
+ if($locked){$mutex.ReleaseMutex()}
+ $mutex.Dispose()
+}
