+"""Small installed control window; all model work stays in the existing host."""
+import os, queue, subprocess, sys, threading, tkinter as tk
+from pathlib import Path
+from tkinter import ttk
+
+ROOT = Path(__file__).resolve().parents[1]
+FLAGS = getattr(subprocess, 'CREATE_NO_WINDOW', 0)
+
+def main():
+    app = tk.Tk(); app.title('STANK TANK — Start here'); app.geometry('540x490')
+    app.minsize(500, 470)
+    panel = ttk.Frame(app, padding=22); panel.pack(fill='both', expand=True)
+    ttk.Label(panel, text='STANK TANK', font=('Segoe UI', 24, 'bold')).pack(anchor='w')
+    ttk.Label(panel, text='GOLD dialogue · Dyad Lite voices', font=('Segoe UI', 11)).pack(anchor='w', pady=(0, 18))
+    status = tk.StringVar(value='Choose Live Show for everyday testing. OBS is optional.')
+    events = queue.Queue(); busy = False; buttons = []
+    def work(script, args=()):
+        nonlocal busy
+        if busy: return
+        busy = True
+        for button in buttons: button.configure(state='disabled')
+        status.set('Preparing the private trial link…' if script=='Start-Buff-Trial.ps1' else
+                   'Stopping Buff access…' if script=='Stop-Buff-Trial.ps1' else
+                   'Starting… Models may take a minute to warm up.' if 'Launch' in script else 'Stopping STANK TANK…')
+        def run():
+            try:
+                result = subprocess.run(['powershell.exe', '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File',
+                    str(ROOT/'scripts'/script), *args], cwd=ROOT, capture_output=True, text=True,
+                    creationflags=FLAGS, timeout=360)
+                if result.returncode:
+                    (ROOT/'private'/'launcher-error.txt').write_text(result.stderr or result.stdout, encoding='utf8')
+                    raise RuntimeError('Startup did not finish. See the local launcher error file; retry after closing any old show.')
+                message = ('Buff link verified. Open his folder and send the current files.' if script=='Start-Buff-Trial.ps1' else
+                           'Buff access stopped. Prepare a new link before his next trial.' if script=='Stop-Buff-Trial.ps1' else
+                           'Stopped. Buff cannot control the show until you start it again.' if 'Stop' in script else
+                           'Ready. Producer controls are open. Leave Live Show open; it can stay in the background.')
+                events.put(('done', message))
+            except Exception as error: events.put(('done', str(error)))
+        threading.Thread(target=run, daemon=True).start()
+    def button(label, script, args=()):
+        item = ttk.Button(panel, text=label, command=lambda: work(script,args)); item.pack(fill='x', pady=4)
+        buttons.append(item)
+    button('Start Live Show — OBS not needed', 'Launch-STANK-TANK.ps1', ('-Mode','browser'))
+    button('Start OBS Reactive mode', 'Launch-STANK-TANK.ps1', ('-Mode','obs'))
+    button('STOP STANK TANK', 'Stop-STANK-TANK.ps1')
+    button('Prepare / verify Buff trial link', 'Start-Buff-Trial.ps1')
+    button('Stop Buff access', 'Stop-Buff-Trial.ps1')
+    def open_buff():
+        folder=ROOT/'For Buff'
+        if folder.exists(): os.startfile(folder)
+        else: status.set('Buff sharing has not been prepared yet.')
+    ttk.Button(panel, text="Open Buff's launcher and instructions", command=open_buff).pack(fill='x', pady=4)
+    ttk.Label(panel, textvariable=status, wraplength=480).pack(anchor='w', pady=(18,4))
+    ttk.Label(panel, text='Closing this window leaves the show running. Use STOP to shut it down.',
+              wraplength=480).pack(anchor='w')
+    def drain():
+        nonlocal busy
+        try:
+            while True:
+                kind, message=events.get_nowait(); status.set(message); busy=False
+                for item in buttons: item.configure(state='normal')
+        except queue.Empty: pass
+        app.after(150,drain)
+    drain()
+    if '--live' in sys.argv: app.after(150,lambda:work('Launch-STANK-TANK.ps1',('-Mode','browser')))
+    if '--obs' in sys.argv: app.after(150,lambda:work('Launch-STANK-TANK.ps1',('-Mode','obs')))
+    app.mainloop()
+
+if __name__ == '__main__': main()
